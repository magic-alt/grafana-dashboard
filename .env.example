# Core runtime
DEPLOYMENT_ENVIRONMENT=local
OBS_SERVICE_NAMESPACE=magic-alt
OBS_PROJECT=grafana-dashboard
LOG_LEVEL=INFO

# PostgreSQL - copy this file to .env and replace both secrets before use.
POSTGRES_DB=stockdash
POSTGRES_USER=stock
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-running
GRAFANA_ANONYMOUS_ENABLED=false

# Stock reference workload
TICKERS=AAPL,MSFT,NVDA,TSLA,SPY,QQQ
YAHOO_PERIOD=1y
YAHOO_INTERVAL=1d
REFRESH_SECONDS=3600
OBS_ANALYSIS_LOAD_FACTOR=12

# OpenTelemetry / LGTM
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
OTEL_COLLECTOR_VERSION=0.160.0
TEMPO_VERSION=2.10.7
TEMPO_PORT=3200
PYROSCOPE_VERSION=2.2.0
PYROSCOPE_PORT=4040
LOKI_VERSION=3.7.7
LOKI_PORT=3100
PROMETHEUS_VERSION=3.14.0
PROMETHEUS_PORT=9090
ALLOY_VERSION=1.18.0
ALLOY_PORT=12345

# Local-only LEAN lab. These paths deliberately default inside the repository instead
# of embedding a developer workstation path. Override them for a real LEAN checkout.
LEAN_PLATFORM_ROOT=./.local/lean-platform
LEAN_DATA_DIR=./.local/lean-data
LEAN_RUNS_DIR=./.local/lean-platform/runs
LEAN_DOCKER_IMAGE=quantconnect/lean:2.5.0.0.17071
LEAN_OBS_CONTROL_PORT=18081
OBS_CONTROL_PORT=18080
