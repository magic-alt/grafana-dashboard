        {
          "datasource": {
            "type": "postgres",
            "uid": "stock-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH selected_symbols AS (\n  SELECT unnest(ARRAY[${symbol:singlequote}]::text[]) AS pattern\n), all_selected AS (\n  SELECT bool_or(pattern IN ('%', CHR(36) || '__all')) AS enabled\n  FROM selected_symbols\n)\nSELECT\n  p.price_time AS \"time\",\n  p.close::double precision AS close,\n  p.symbol\nFROM stock_prices p\nWHERE $__timeFilter(p.price_time)\n  AND (\n    COALESCE((SELECT enabled FROM all_selected), true)\n    OR EXISTS (SELECT 1 FROM selected_symbols s WHERE p.symbol LIKE s.pattern)\n  )\nORDER BY 1, p.symbol;",
          "refId": "A"
        }
      ],
      "title": "Close Price",
      "type": "timeseries"
