          "rawQuery": true,
          "rawSql": "WITH selected_percentile AS (\n  SELECT CASE '${percentile}' WHEN 'p75' THEN 0.75 WHEN 'p95' THEN 0.95 ELSE 0.50 END AS q\n), runs AS (\n  SELECT run_id, completed_at, critical_path_ms::double precision AS critical_path_ms\n  FROM lean_backtest_runs\n  WHERE status = 'ok' AND critical_path_ms IS NOT NULL\n), target AS (\n  SELECT percentile_cont((SELECT q FROM selected_percentile)) WITHIN GROUP (ORDER BY critical_path_ms) AS target_ms FROM runs\n), nearest AS (\n  SELECT r.run_id\n  FROM runs r CROSS JOIN target t\n  WHERE t.target_ms IS NOT NULL\n  ORDER BY ABS(r.critical_path_ms - t.target_ms), r.completed_at DESC\n  LIMIT 5\n)\nSELECT t.stage, AVG(t.duration_ms)::double precision AS avg_duration_ms, MAX(t.duration_ms)::double precision AS max_duration_ms, COUNT(*) AS sample_runs\nFROM lean_backtest_stage_timings t\nJOIN nearest n USING (run_id)\nGROUP BY t.stage\nORDER BY avg_duration_ms DESC;",
          "refId": "A"
        }
      ],
