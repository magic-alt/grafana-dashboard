      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "stock-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected_percentile AS (\n  SELECT CASE '${percentile}' WHEN 'p75' THEN 0.75 WHEN 'p95' THEN 0.95 ELSE 0.50 END AS q\n), runs AS (\n  SELECT completed_at, run_id, symbol, data_source, trace_id, critical_path_ms::double precision AS critical_path_ms,\n         dominant_stage, reason_code, reason_summary\n  FROM lean_backtest_runs\n  WHERE status = 'ok' AND critical_path_ms IS NOT NULL\n), target AS (\n  SELECT percentile_cont((SELECT q FROM selected_percentile)) WITHIN GROUP (ORDER BY critical_path_ms) AS target_ms FROM runs\n), nearest AS (\n  SELECT r.*, ABS(r.critical_path_ms - t.target_ms) AS distance_ms, t.target_ms\n  FROM runs r CROSS JOIN target t\n  WHERE t.target_ms IS NOT NULL\n  ORDER BY ABS(r.critical_path_ms - t.target_ms), r.completed_at DESC\n  LIMIT 5\n), reason_rank AS (\n  SELECT COALESCE(reason_code, 'unknown') AS reason_code,\n         COALESCE(reason_summary, 'No reason summary recorded') AS reason_summary,\n         COUNT(*) AS reason_runs,\n         AVG(critical_path_ms) AS reason_avg_ms\n  FROM nearest\n  GROUP BY 1, 2\n  ORDER BY reason_runs DESC, reason_avg_ms DESC\n  LIMIT 1\n), aggregate AS (\n  SELECT COUNT(*) AS sample_runs, AVG(critical_path_ms) AS avg_latency_ms, MAX(critical_path_ms) AS max_latency_ms, MIN(target_ms) AS target_latency_ms FROM nearest\n)\nSELECT '${percentile}' AS percentile,\n       aggregate.sample_runs,\n       aggregate.target_latency_ms::double precision AS target_latency_ms,\n       aggregate.avg_latency_ms::double precision AS avg_latency_ms,\n       aggregate.max_latency_ms::double precision AS max_latency_ms,\n       reason_rank.reason_code,\n       reason_rank.reason_summary\nFROM aggregate\nLEFT JOIN reason_rank ON true;",
          "refId": "A"
        }
      ],
      "title": "Selected Percentile Reason",
      "type": "table"
    },
